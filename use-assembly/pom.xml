<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tzi.use</groupId>
        <artifactId>use</artifactId>
        <version>7.5.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <packaging>pom</packaging>
    <artifactId>use-assembly</artifactId>
    <name>USE Distribution</name>
    <description>Binary distribution archive of USE. Not published to Maven Central.</description>

    <properties>
        <!-- distribution zip is not deployed (also covers the release profile) -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <skipPublishing>true</skipPublishing>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.tzi.use</groupId>
            <artifactId>use-gui</artifactId>
            <version>7.5.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.4.0</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/generated-resources/license</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <excludedScopes>test,provided,system</excludedScopes>
                    <excludedGroups>org\.tzi\.use</excludedGroups>
                    <acceptPomPackaging>true</acceptPomPackaging>
                    <failOnMissing>false</failOnMissing>
                    <failOnBlacklist>false</failOnBlacklist>
                    <licenseMerges>
                        <licenseMerge>The Apache Software License, Version 2.0|Apache License, Version 2.0|Apache 2.0|Apache-2.0|Apache License 2.0|Apache 2|Apache Software License - Version 2.0|Apache License v2.0|The Apache License, Version 2.0|Apache License, version 2.0</licenseMerge>
                        <licenseMerge>BSD 3-Clause License|The 3-Clause BSD License|BSD-3-Clause|BSD 3-Clause|The BSD 3-Clause License|New BSD License|3-Clause BSD License</licenseMerge>
                        <licenseMerge>MIT License|MIT|The MIT License</licenseMerge>
                    </licenseMerges>
                </configuration>
                <executions>
                    <execution>
                        <id>add-third-party</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/assembly.xml</descriptor>
                    </descriptors>
                    <finalName>use-${project.version}</finalName>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>